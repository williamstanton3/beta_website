# Beta Sigma Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Admin panel password — change this before deploying!
ADMIN_PASSWORD=BetaSigma2024!

# Secret key used to sign JWT tokens — make this long and random in production
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production

# Allowed browser origins for CORS — JSON array of your deployed frontend URL(s)
# CORS_ORIGINS=["https://yourdomain.com"]

# Where to store JSON content and uploaded media in production. Leave unset
# for local development (defaults to folders next to the app's source code).
# Point these at a mounted persistent volume when deploying (e.g. Railway),
# so admin edits/uploads survive redeploys.
# DATA_DIR=/data/app-data
# MEDIA_DIR=/data/media
