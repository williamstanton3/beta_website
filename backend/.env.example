# Beta Sigma Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Admin panel password — change this before deploying!
ADMIN_PASSWORD=BetaSigma2024!

# Secret key used to sign JWT tokens — make this long and random in production
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
